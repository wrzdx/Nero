package web_views

import "strconv"

templ Brand() {
    <a href="/" aria-label="Nero — главная" class="auth-brand">
        <img src="/static/images/nero-cut.svg" width="34" height="34" alt=""/>
        <span>Nero</span>
    </a>
}

templ AuthShell(title string, register bool) {
    @Layout(title) {
        <div class={ "auth-shell", templ.KV("auth-register", register) }>
            <aside class="auth-story" aria-label="Nero">
                @Brand()
                <div class="auth-orbit" aria-hidden="true"></div>
                <blockquote class="auth-quote">
                    if register {
                        <p>Я здесь ищу только одного,<br/>б*#ть, — покоя, умиротворения<br/>и вот этой гармонии.</p>
                    } else {
                        <p>Я, б*#ть, в своём познании<br/>настолько преисполнился…</p>
                    }
                </blockquote>
                <div class="auth-story-footer"><span>Nero</span><span lang="ja">黒</span></div>
            </aside>
            <main class="auth-panel">
                <div class="auth-body">
                    <div class="auth-mobile-brand">
                        @Brand()
                    </div>
                    <div class="auth-mobile-orbit" aria-hidden="true"></div>
                    { children... }
                </div>
            </main>
        </div>
    }
}

templ FormMessage(message string) {
    if message != "" {
        <div role="alert" class="mb-6 rounded-nero border border-nero-accent/40 bg-nero-accent/5 px-4 py-3 text-xs leading-6 text-nero-text">{ message }</div>
    }
}

templ FieldHint(id string, hint string, errorMessage string) {
    if errorMessage != "" {
        <p id={ id + "-hint" } role="alert" class="auth-field-hint text-nero-accent">{ errorMessage }</p>
    } else if hint != "" {
        <p id={ id + "-hint" } class="auth-field-hint text-nero-muted">{ hint }</p>
    }
}

templ TextField(name string, label string, placeholder string, autocomplete string, value string, errorMessage string, hint string, min int, max int, pattern string) {
    <div class="auth-field">
        <label for={ name } class="text-[11px]">{ label }</label>
        <input
            id={ name }
            name={ name }
            type="text"
            value={ value }
            placeholder={ placeholder }
            autocomplete={ autocomplete }
            minlength={ strconv.Itoa(min) }
            maxlength={ strconv.Itoa(max) }
            if pattern != "" {
                pattern={ pattern }
            }
            if hint != "" || errorMessage != "" {
                aria-describedby={ name + "-hint" }
            }
            aria-invalid={ strconv.FormatBool(errorMessage != "") }
            class="auth-input"
            required
        />
        @FieldHint(name, hint, errorMessage)
    </div>
}

templ PasswordField(autocomplete string, placeholder string, errorMessage string, hint string, min int) {
    <div class="auth-field">
        <label for="password" class="text-[11px]">Пароль</label>
        <div class="auth-password">
            <input id="password" name="password" type="password" autocomplete={ autocomplete } placeholder={ placeholder } minlength={ strconv.Itoa(min) } class="auth-input pr-12" aria-invalid={ strconv.FormatBool(errorMessage != "") } required
                if hint != "" || errorMessage != "" {
                    aria-describedby="password-hint"
                }
            />
            <button type="button" data-password-toggle aria-controls="password" aria-label="Показать пароль" aria-pressed="false" class="auth-password-toggle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle><path data-eye-slash d="m3 3 18 18" class="hidden"></path></svg>
            </button>
        </div>
        @FieldHint("password", hint, errorMessage)
    </div>
}

templ SubmitButton(label string) {
    <button type="submit" class="auth-submit">
        <span>{ label }</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"></path></svg>
    </button>
}

templ Welcome() {
    @AuthShell("Вы вошли — Nero", false) {
        <section aria-labelledby="welcome-title">
            <p class="mb-3 text-[11px] tracking-[0.12em] text-nero-muted">Всё готово</p>
            <h1 id="welcome-title" class="text-[26px] font-medium tracking-[-1px]">Вы вошли в Nero.</h1>
            <p class="mt-4 text-xs leading-7 text-nero-muted">Вход выполнен успешно.</p>
            <a href="/login" class="auth-link mt-8 inline-block text-xs">Войти в другой аккаунт</a>
        </section>
    }
}
