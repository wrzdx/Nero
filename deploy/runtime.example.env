# Copy this template to runtime.env on the server for a fresh deployment.
# For an update, start with the previous release's runtime.env instead.
# Edit the new copy only; retain the previous release's file for rollback.

# required
# Use the exact image reference from this archive's build.json, including digest.
APP_IMAGE=
# Public HTTPS origin, for example https://nero.wrzdx.tech.
APP_ORIGIN=
# Host loopback port used by Nginx; the existing deployment uses 5051.
APP_PORT=
# Persistent data root; the existing deployment uses /srv/messenger.
MESSENGER_ROOT=
# Preserve the existing signing key when updating an existing deployment.
JWT_SECRET=
# Use the password of the existing PostgreSQL role when updating.
POSTGRES_PASSWORD=

# optional
# DB_MEMORY_LIMIT=384m
# DB_CPU_LIMIT=1.0
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_USER=messenger
# POSTGRES_DB=messenger
# POSTGRES_TIMEOUT=10s
# POSTGRES_SSLMODE=disable
# POSTGRES_SSLROOTCERT=
# APP_MEMORY_LIMIT=256m
# APP_CPU_LIMIT=1.0
# APP_STOP_GRACE_PERIOD=35s
# GOMEMLIMIT=192MiB
# HTTP_SHUTDOWN_TIMEOUT=30s
# TIME_ZONE=UTC
# LOGGER_LEVEL=INFO
# AUTH_ACCESS_TOKEN_TTL=15m
# AUTH_SESSION_TTL=24h
